# Canonical base URL (no trailing slash). Used for canonical links, sitemap, RSS.
NEXT_PUBLIC_SITE_URL=https://www.flowersinagun.com
# Contact address for "Advertise" and "Submit your band" mailto links.
NEXT_PUBLIC_CONTACT_EMAIL=
# Show ad slots to readers. Leave unset/false until an ad network is wired in components/AdSlot.tsx.
NEXT_PUBLIC_ADS_ENABLED=false

# Keystatic GitHub mode (production only). See README.md -> "Keystatic setup".
# Dev only: set to "github" once to run the GitHub App setup flow locally.
# NEXT_PUBLIC_KEYSTATIC_STORAGE=github
NEXT_PUBLIC_KEYSTATIC_GITHUB_REPO=SimoSabev/Flowers-in-a-gun
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=
NEXT_PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=
